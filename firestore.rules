rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return isAuthenticated() && userDoc().disabled != true;
    }

    function isAdmin() {
      return isActive() && userDoc().role == 'admin';
    }

    // Users collection
    // Workers may only get their own profile (AuthContext needs it even when disabled).
    // List access for active users is needed to send notifications to all users on note creation.
    // Admin reads all profiles.
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isAdmin();
      allow list: if isActive();
      allow create: if isAdmin();
      allow update: if isAdmin() || (isActive() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Objects collection
    match /objects/{objectId} {
      allow read: if isActive();
      allow create: if isAdmin();
      // Workers can update object fields but cannot touch archived/archivedAt — only admin can.
      allow update: if isAdmin() ||
        (isActive() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived', 'archivedAt']));
      allow delete: if isAdmin();

      match /notes/{noteId} {
        allow read: if isActive();
        allow create: if isActive();
        allow update, delete: if isAdmin() || (isActive() && resource.data.authorId == request.auth.uid);
      }

      match /photos/{photoId} {
        allow read: if isActive();
        allow create: if isActive();
        allow delete: if isAdmin() || (isActive() && resource.data.uploadedBy == request.auth.uid);
      }
    }

    // Work hours
    // Admin: read all, create for any worker. Cannot edit or delete anyone's entries.
    // Worker: full access to own entries only.
    match /workHours/{entryId} {
      allow read:   if isAdmin() || (isActive() && resource.data.userId == request.auth.uid);
      allow create: if isActive() && request.resource.data.userId == request.auth.uid;
      allow update: if isActive() && resource.data.userId == request.auth.uid;
      allow delete: if isActive() && resource.data.userId == request.auth.uid;
    }

    // Notifications
    // Any active user can delete any notification so that photo/note deletion
    // can clean up notifications for all users.
    match /notifications/{userId}/items/{notifId} {
      allow read, update: if isActive() && request.auth.uid == userId;
      allow create: if isActive();
      allow delete: if isActive();
    }
  }
}
